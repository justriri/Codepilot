# --- Model provider selection ---
# Which provider powers the agent. Options: anthropic, deepseek, openai, local
DEFAULT_MODEL=deepseek

# --- DeepSeek ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro

# --- Optional providers (leave empty) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local model (optional) ---
LOCAL_MODEL_NAME=
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1

# --- Agent core ---
WORKSPACE_ROOT=./workspace
MAX_ITERATIONS=35
COMMAND_TIMEOUT_S=30

# --- Sandbox (E2B cloud) ---
# Get a key at https://e2b.dev/docs — required for create_sandbox to work.
E2B_API_KEY=your_e2b_api_key_here
SANDBOX_TTL_S=600

# Optional: pre-built E2B template with Playwright at /opt/agent-tools
# Build with: ./e2b/build-template.sh — see docs/E2B_TEMPLATE.md
E2B_TEMPLATE_ID=

# Browser for verification: auto | all | firefox | chromium | webkit
# auto picks firefox on E2B, chromium on custom templates; all runs every engine
BROWSER_ENGINE=auto

# --- Debugging loop ---
MAX_REPAIR_ATTEMPTS=3
DEBUG_AGENT_MAX_ITERATIONS=6

# --- x402 payment layer (paid A2MCP verification API) ---
# See docs/X402_PAYMENTS.md for full setup, deployment, and testing
# instructions. Every value here is required for the payment gate to
# activate; if any is missing/invalid, the server logs a warning and
# serves /api/agent-interface/* WITHOUT a payment gate instead of
# crashing (see payments/validation.py).

# Master switch. Set to false to disable x402 entirely (e.g. local dev).
X402_ENABLED=true

# X Layer mainnet.
X402_CHAIN_ID=196

# No default on purpose: no x402 facilitator for X Layer is officially
# documented as of this writing. Verify one yourself before enabling
# payments in production — see docs/X402_PAYMENTS.md.
X402_FACILITATOR_URL=

# USD₮0 on X Layer, from OKX's official token list
# (https://github.com/okx/xlayer-tokenlist) — do not substitute an
# address from anywhere else without re-verifying it against that repo.
X402_TOKEN_ADDRESS=0x779Ded0c9e1022225f8E0630b35a9b54bE713736
X402_TOKEN_DECIMALS=6
X402_TOKEN_SYMBOL=USD₮0

# The token contract's EIP-712 domain name/version, required for the
# 'exact' scheme's EIP-3009 signature. Read these from the contract
# itself (e.g. its `name()`/`EIP712_DOMAIN()` on OKLink's "Read
# Contract" tab) — do not guess.
X402_TOKEN_EIP712_NAME=
X402_TOKEN_EIP712_VERSION=2

# Flat per-call price in the token's human units (e.g. "0.10" = 0.10 USD₮0).
X402_PRICE=0.10

# Where payment settles. Defaults to CodePilot's ASP wallet address.
X402_PAY_TO_ADDRESS=0xff67a208df0dd71fea796af3a334b14fa687fc3a

# How long a signed payment authorization stays valid, in seconds.
X402_MAX_TIMEOUT_SECONDS=300
